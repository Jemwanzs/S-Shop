# ── Required ─────────────────────────────────────────────────
# Railway: reference the Postgres service →  ${{Postgres.DATABASE_URL}}
DATABASE_URL=postgres://postgres:password@localhost:5432/sshop
# 32+ random characters. Changing it signs everyone out.
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars

# Public base URL (webhook callbacks, tracking links). On Railway this
# defaults to https://${RAILWAY_PUBLIC_DOMAIN} when left unset.
# PUBLIC_URL=https://sshop.example.com
PORT=8080
# Built web app directory (Docker image sets /app/web)
WEB_DIR=web/dist
# Only needed when the web app is served from a different origin:
# CORS_ORIGINS=http://localhost:5173

# ── First run: creates the business + administrator on an empty database
BOOTSTRAP_BUSINESS_NAME=Mali-Safi Kibandaski
# BOOTSTRAP_BUSINESS_SLUG=mali-safi-kibandaski
BOOTSTRAP_ADMIN_NAME=Administrator
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PIN=1234

# ── M-Pesa Daraja STK Push (optional) ────────────────────────
# MPESA_ENV=sandbox                       # or production
# MPESA_CONSUMER_KEY=
# MPESA_CONSUMER_SECRET=
# MPESA_SHORTCODE=174379
# MPESA_PASSKEY=
# MPESA_TRANSACTION_TYPE=CustomerPayBillOnline   # Till: CustomerBuyGoodsOnline
# MPESA_PARTY_B=                          # Till number for Buy Goods; defaults to shortcode
# MPESA_CALLBACK_TOKEN=long-random-secret # part of the callback URL

# ── WhatsApp Cloud API (optional) ────────────────────────────
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_VERIFY_TOKEN=long-random-secret
# WHATSAPP_APP_SECRET=                    # verifies webhook signatures
# WHATSAPP_NOTIFICATION_TEMPLATE=sshop_notification   # approved template with one {{1}} body variable
# WHATSAPP_TEMPLATE_LANGUAGE=en
# WHATSAPP_API_VERSION=v21.0

RUST_LOG=info,sqlx=warn,tower_http=info

# Access requests (docs/modules/18-access-requests.md)
# PLATFORM_ADMIN_EMAILS=you@example.com
# RESEND_API_KEY=re_...
# MAIL_FROM=S'Shop <noreply@yourdomain.com>
# ACCESS_REQUEST_NOTIFY_EMAILS=you@example.com
